# Copy this file to secrets.toml (same folder) to run with a cloud database on your laptop.
# On Streamlit Cloud, paste these lines into App settings -> Secrets instead.
# secrets.toml is in .gitignore, so it is never uploaded to GitHub.
DATABASE_URL = "postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
ADMIN_PASSWORD = "choose-a-password"

# Email verification (optional). SMTP_PASSWORD is a Gmail *App password*, not your normal password.
SMTP_USER = "you@gmail.com"
SMTP_PASSWORD = "xxxx xxxx xxxx xxxx"
