# Copy this file to secrets.toml (same folder) to run with a cloud database on your laptop.
# On Streamlit Cloud, paste these two lines into App settings -> Secrets instead.
# secrets.toml is in .gitignore, so it is never uploaded to GitHub.
DATABASE_URL = "postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
ADMIN_PASSWORD = "choose-a-password"
